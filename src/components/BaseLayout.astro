---
import '../styles/global.css';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

export interface Props {
  title: string;
  description?: string;
  // Layout width. Default narrow (max-w-2xl ≈ 672px) is right for article
  // reading — long-form prose stays at ~60-75 chars per line. Index pages,
  // grids, the buildlog, and the homepage cards opt in to wide (max-w-6xl
  // ≈ 1152px) so they can breathe on desktop instead of feeling boxed in.
  wide?: boolean;
  // Keep the page out of search results. Draft posts and research still
  // build and deploy at their final URLs until the Monday publish cron
  // flips them, so their routes set this; the sitemap filter in
  // astro.config.mjs drops the same URLs.
  noindex?: boolean;
  // Social preview image for this page (a post's banner). Without one, the
  // site-wide square /og-image.png is used with a small summary card.
  image?: { src: string; width: number; height: number; alt?: string };
}
const {
  title,
  description = 'Build-in-public hub for Neural Bridge and other projects.',
  wide = false,
  noindex = false,
  image,
} = Astro.props;
const og = image
  ? { src: new URL(image.src, Astro.site).href, width: image.width, height: image.height, alt: image.alt }
  : { src: new URL('/og-image.png', Astro.site).href, width: 1024, height: 1024, alt: undefined };

const widthClass = wide ? 'max-w-6xl' : 'max-w-2xl';
---
<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" type="application/rss+xml" title="neural-bridge.dev" href="/rss.xml" />

    <!-- Fonts: Fraunces (variable, opsz axis), Albert Sans, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..700,30..100,0..1;1,9..144,400..600,30..100,0..1&family=Albert+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={og.src} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    {og.alt && <meta property="og:image:alt" content={og.alt} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:image" content={og.src} />
    {og.alt && <meta name="twitter:image:alt" content={og.alt} />}

    <title>{title}</title>
  </head>
  <body class="bg-cream-100 text-cream-900 dark:bg-cream-950 dark:text-cream-100 antialiased min-h-full flex flex-col">
    <Nav wide={wide} />
    <main class={`flex-1 w-full ${widthClass} mx-auto px-6 py-12 sm:py-16`}>
      <slot />
    </main>
    <Footer wide={wide} />
  </body>
</html>
