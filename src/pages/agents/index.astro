---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import TranslateToggle from '../../components/TranslateToggle.astro';
import { AGENT_COLOR_HEX, assertAgentTranslationMatches, getAgentAvatarIds } from '../../lib/agent-profiles.mjs';

const agents = (await getCollection('agents', ({ id }) => !id.startsWith('ko/')))
  .sort((a, b) => a.data.display_name.localeCompare(b.data.display_name));

const profiles = await Promise.all(agents.map(async agent => {
  const translation = await getEntry('agents', `ko/${agent.slug}`);
  const variants: { locale: 'en' | 'ko'; data: CollectionEntry<'agents'>['data'] }[] = [
    { locale: 'en', data: agent.data },
  ];
  if (translation) {
    assertAgentTranslationMatches(agent.data, translation.data);
    variants.push({ locale: 'ko', data: translation.data });
  }
  return { data: agent.data, variants };
}));

const directoryCopy = {
  en: {
    intro: 'My agent team, organized around the work we do together. Each profile explains when to bring an agent in, what a useful result looks like, and where its responsibility stops. Access and available actions differ by agent and conversation channel.',
    recruiterFooter: 'Recruiter helps shape a new specialist when there is a real job to fill. Its proposal still needs review; designing an agent is not the same as granting permissions or putting it into service.',
  },
  ko: {
    intro: '함께 하는 일을 중심으로 소개하는 제 AI 동료들입니다. 각 프로필은 언제 해당 에이전트와 일하면 좋은지, 어떤 결과를 기대할 수 있는지, 책임 범위는 어디까지인지를 설명합니다. 접속 방법과 사용 가능한 기능은 에이전트와 대화 채널에 따라 다릅니다.',
    recruiterFooter: 'Recruiter는 실제로 필요한 일이 생겼을 때 새 전문 에이전트의 역할을 설계합니다. 제안은 검토를 거쳐야 합니다. 에이전트를 설계하는 일과 권한을 부여하거나 운영을 시작하는 일은 서로 다릅니다.',
  },
};
const availableAvatars = await getAgentAvatarIds();
---
<BaseLayout title="Agents · neural-bridge.dev" description={directoryCopy.en.intro} wide>
  <header class="mb-12 pt-4">
    <p class="font-mono text-xs text-rust-500 uppercase tracking-wider mb-3">// The roster</p>
    <div class="flex items-baseline justify-between gap-3 mb-4 flex-wrap">
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold tracking-tight" style="font-variation-settings: 'opsz' 96, 'SOFT' 60;">Agents</h1>
      <TranslateToggle hasKorean={true} />
    </div>
    <p data-lang="en" class="text-cream-700 dark:text-cream-300 max-w-3xl leading-relaxed">{directoryCopy.en.intro}</p>
    <p data-lang="ko" hidden aria-hidden="true" lang="ko" class="text-cream-700 dark:text-cream-300 max-w-3xl leading-relaxed">{directoryCopy.ko.intro}</p>
  </header>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    {profiles.map(agent => {
      const accent = AGENT_COLOR_HEX[agent.data.color];
      const hasAvatar = availableAvatars.has(agent.data.id);
      return (
        <a
          href={`/agents/${agent.data.id}`}
          class="group block border border-cream-200 dark:border-cream-900 rounded-lg overflow-hidden hover:border-rust-500 transition-colors bg-cream-50 dark:bg-cream-950"
        >
          <div class="h-1.5" style={`background-color: ${accent};`} aria-hidden="true"></div>
          <div class="p-5 flex items-start gap-4">
            <div class="min-w-0 flex-1">
              {agent.variants.map(({ locale, data }) => (
                <div
                  data-lang={agent.variants.length > 1 ? locale : undefined}
                  hidden={locale === 'ko'}
                  aria-hidden={locale === 'ko' ? 'true' : undefined}
                  lang={locale}
                >
                  <h2 class="font-serif text-xl font-semibold tracking-tight mb-2 group-hover:text-rust-500 transition-colors leading-snug" style="font-variation-settings: 'opsz' 60, 'SOFT' 50;">
                    {data.role_tagline}
                  </h2>
                  <p class="font-mono text-sm mb-3">{data.display_name}</p>
                  {data.description && (
                    <p class="text-sm text-cream-700 dark:text-cream-300 leading-relaxed mb-3">{data.description}</p>
                  )}
                  {data.jobs.length > 0 && (
                    <ul class="space-y-1 text-sm text-cream-700 dark:text-cream-300 mb-3">
                      {data.jobs.map(job => <li>{job.title}</li>)}
                    </ul>
                  )}
                </div>
              ))}
              <div class="flex items-baseline gap-x-2 mb-3">
                <span class="font-mono text-[11px] uppercase tracking-wider" style={`color: ${accent};`}>// {agent.data.color}</span>
                {agent.data.is_orchestrator && (
                  <span class="font-mono text-[11px] uppercase tracking-wider text-rust-500">· orchestrator</span>
                )}
              </div>
              <p class="font-mono text-[10px] uppercase tracking-wider text-cream-600 dark:text-cream-400 group-hover:text-rust-500 transition-colors">
                View profile &rarr;
              </p>
            </div>
            <div class="w-16 h-16 shrink-0 rounded-md overflow-hidden bg-cream-100 dark:bg-cream-900 flex items-center justify-center">
              {hasAvatar ? (
                <img
                  src={`/agents/${agent.data.id}.png`}
                  alt={`${agent.data.display_name} avatar`}
                  width="64"
                  height="64"
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              ) : (
                <span class="font-serif text-xl font-semibold text-cream-700 dark:text-cream-300" aria-hidden="true">
                  {agent.data.display_name.charAt(0)}
                </span>
              )}
            </div>
          </div>
        </a>
      );
    })}
  </div>

  <div class="mt-10 border-t border-cream-200 dark:border-cream-900 pt-6">
    <p data-lang="en" class="text-sm text-cream-700 dark:text-cream-300 leading-relaxed max-w-3xl">{directoryCopy.en.recruiterFooter}</p>
    <p data-lang="ko" hidden aria-hidden="true" lang="ko" class="text-sm text-cream-700 dark:text-cream-300 leading-relaxed max-w-3xl">{directoryCopy.ko.recruiterFooter}</p>
  </div>
</BaseLayout>
